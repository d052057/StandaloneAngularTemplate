{
  "$schema": "http://json.schemastore.org/template",
  "author": "Yitong Phou",
  "classifications": ["Web", "Angular", "Standalone"],
  "identity": "standaloneangulartemplate.template",
  "name": "Standalone Angular with .NET",
  "shortName": "standalone-angular",
  "sourceName": "StandaloneAngularTemplate",
  "preferNameDirectory": true,
  "symbols": {
    "clientNameLowerCase": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "name",
        "toLower": true
      },
      "replaces": "standaloneangulartemplate"
    }
  },
  "sources": [
    {
      "exclude": [
        "README.md",
        "docs/**",
        "**/CHANGELOG.md"
      ]
    }
  ]
}
